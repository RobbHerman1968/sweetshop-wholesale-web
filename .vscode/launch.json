{
    "version": "0.2.0",
    "configurations": [
        {
            // Start Next.js dev server with Node inspector
            "name": "Next.js: server",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}",
            "env": {
                "NODE_OPTIONS": "--inspect=9229"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // Attach Chrome/Edge to debug client-side code
            "name": "Next.js: client",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true
        }
    ],
    "compounds": [
        {
            "name": "Sweetshop: server + client",
            "configurations": ["Next.js: server", "Next.js: client"]
        }
    ]
}
